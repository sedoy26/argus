# Argus Watcher-Sourcify — copy to .env and adjust (optional; defaults work for Sepolia demo)

# signal-api (match reset.sh: PORT=8788)
ARGUS_API=http://127.0.0.1:8788

# Comma-separated targets: <chainId>:<0x…>[:label]
# Default in code: Sepolia FakeSwapNet demo address
# WATCHER_TARGETS=11155111:0x3b38fe80891ec608829e941ef965e1c96d3460d6:FakeSwapNet

# Identity (must match ArgusRegistry ENS for reputation weighting in demos)
# WATCHER_SUBMITTER=watcher-sourcify.agents.argus-security.eth

# WATCHER_REPUTATION=85
# WATCHER_POLL_MS=60000

# When sourcify.dev has no verified files for the demo address, load repo source:
# WATCHER_LOCAL_FALLBACK=1   (set to 0 to disable)
# WATCHER_LOCAL_SOL_PATH=/absolute/path/to/FakeSwapNet.sol

# Optional: override demo contract address (must match dashboard / guardian GUARDIAN_SPENDER)
# FAKE_SWAPNET_ADDRESS=0x3b38fe80891ec608829e941ef965e1c96d3460d6

# ENS bootstrap for watcher-sourcify.agents.argus-security.eth text records
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
