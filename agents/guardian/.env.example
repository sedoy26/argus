# Argus Guardian configuration
#
# Copy to .env and fill in. Signer priority:
#   • KmsSigner when ORBITPORT_CLIENT_ID + ORBITPORT_CLIENT_SECRET + KMS_KEY_ID
#     are all set (Space KMS — used for hackathon / production demos).
#   • LocalSigner when GUARDIAN_PRIVATE_KEY is set, or when you set
#     GUARDIAN_FORCE_LOCAL_SIGNER=1 to prefer local keys even if Orbitport is configured.

# ----- chain ---------------------------------------------------------
RPC_URL=http://127.0.0.1:8545

# ----- protection scope ---------------------------------------------
# The address whose risk score we monitor (and revoke approvals to).
GUARDIAN_SPENDER=0xdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# Comma-separated ERC-20 tokens to revoke approvals on.
GUARDIAN_TOKENS=0x0000000000000000000000000000000000000000
# Score level to act on. NONE | YELLOW | ORANGE | RED | CRITICAL.
GUARDIAN_THRESHOLD=CRITICAL
GUARDIAN_POLL_MS=5000

# ----- signer (KMS preferred when Orbitport trio is complete) ---------

# Path A: local key (dev / smoke). Use GUARDIAN_FORCE_LOCAL_SIGNER=1 if you also
# have Orbitport vars but want Anvil/local signing for this process.
# GUARDIAN_PRIVATE_KEY=0x...
# GUARDIAN_FORCE_LOCAL_SIGNER=1

# Path B: SpaceComputer Orbitport KMS (production / prize demo).
# ORBITPORT_CLIENT_ID=...
# ORBITPORT_CLIENT_SECRET=...
# KMS_KEY_ID=...
# Optional override:
# KMS_KEY_ADDRESS=0x...    # skip the recovery probe round-trip
# ORBITPORT_AUTH_DOMAIN=auth.spacecomputer.io
# ORBITPORT_API_URL=https://op.spacecomputer.io

# ----- signal-api ---------------------------------------------------
ARGUS_API=http://127.0.0.1:8787
# Optional: same value as signal-api ARGUS_TELEMETRY_SECRET — posts revoke milestones to the live feed (Space KMS badge).
# ARGUS_TELEMETRY_SECRET=...
#
# One-shot KMS demo for judges (createKey → sign revoke digest → telemetry):
#   bun run kms-demo
