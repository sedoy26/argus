{
  "_readme": "Copy to railway.deploy.config.json. Optional projectId. Never put API tokens here — use RAILWAY_API_TOKEN or RAILWAY_PROJECT_ACCESS_TOKEN in the shell only.",
  "projectId": "",
  "githubRepo": "YOUR_ORG/heg",
  "branch": "main",
  "environmentName": "production",
  "services": [
    {
      "matchName": "dashboard",
      "rootDirectory": "dashboard",
      "railwayConfigFile": "/dashboard/railway.toml"
    },
    {
      "matchName": "signal",
      "rootDirectory": "platform/signal-api",
      "railwayConfigFile": "/platform/signal-api/railway.toml"
    },
    {
      "matchName": "gateway",
      "rootDirectory": "platform/ens-resolver",
      "railwayConfigFile": "/platform/ens-resolver/railway.toml"
    }
  ]
}
