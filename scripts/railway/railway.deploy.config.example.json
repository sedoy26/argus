{
  "_readme": "Repo tracks scripts/railway/railway.deploy.config.json — fork: edit projectId + githubRepo. Never put API tokens in JSON; use RAILWAY_API_TOKEN in the shell.",
  "projectId": "ec21f2a5-c933-4436-8a2a-fa16a9aba733",
  "githubRepo": "doy26/argus",
  "branch": "main",
  "environmentName": "production",
  "services": [
    {
      "matchName": "dashboard",
      "rootDirectory": "dashboard",
      "railwayConfigFile": "/dashboard/railway.toml",
      "watchPatterns": ["/dashboard/**"]
    },
    {
      "matchName": "signal",
      "rootDirectory": "platform/signal-api",
      "railwayConfigFile": "/platform/signal-api/railway.toml",
      "watchPatterns": ["/platform/signal-api/**"]
    },
    {
      "matchName": "gateway",
      "rootDirectory": "platform/ens-resolver",
      "railwayConfigFile": "/platform/ens-resolver/railway.toml",
      "watchPatterns": ["**"]
    }
  ]
}
