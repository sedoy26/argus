{
  "name": "argus-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:reset": "VITE_API_TARGET=http://127.0.0.1:8788 VITE_GW_TARGET=http://127.0.0.1:8789 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "start": "sh -c \"exec serve dist -s -l tcp://0.0.0.0:${PORT:-3000}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10"
  }
}
