# Build-time (production / Railway). Copy to `.env` for local `bun run build`.
# Omit in dev to use Vite `/api` and `/gw` proxies for signal-api + gateway.

# VITE_SIGNAL_API=https://your-signal-api.up.railway.app
# VITE_GATEWAY_URL=https://your-ens-gateway.up.railway.app

# Sepolia ArgusRegistry — required after redeploying the contract (default in code if unset).
# VITE_ARGUS_REGISTRY_ADDRESS=0xc91Ed23CF4945b26a4ff510295A105677D66F1EB

# ENS wildcard parent for CCIP demo labels `[addr].<parent>`
# VITE_ARGUS_ENS_PARENT=risks.argus-security.eth
